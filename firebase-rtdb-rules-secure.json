{
  "rules": {
    ".read": false,
    ".write": false,

    "menu_v7": {
      ".read": "auth != null && (auth.token.role === 'garson' || auth.token.role === 'admin')",
      "$itemId": {
        ".write": "auth != null && auth.token.role === 'admin'",
        ".validate": "newData.hasChildren(['name', 'price', 'category']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('price').val() <= 100000 && newData.child('category').isString()"
      }
    },

    "stock_v7": {
      ".read": "auth != null && (auth.token.role === 'garson' || auth.token.role === 'admin')",
      "$safeName": {
        ".write": "auth != null && auth.token.role === 'admin'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
      }
    },

    "masalar_v7": {
      ".read": "auth != null && (auth.token.role === 'garson' || auth.token.role === 'admin')",
      "$zone": {
        "$tableId": {
          ".write": "auth != null && (auth.token.role === 'garson' || auth.token.role === 'admin')",
          "orders": {
            "$orderId": {
              ".validate": "newData.hasChildren(['name', 'price']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('price').isNumber() && newData.child('price').val() >= 0 && newData.child('price').val() <= 100000"
            }
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          }
        }
      }
    },

    "reports_v7": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    },

    "ikram_v7": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && (auth.token.role === 'garson' || auth.token.role === 'admin')"
    },

    "ayarlar_v7": {
      ".read": "auth != null && auth.token.role === 'admin'",
      ".write": "auth != null && auth.token.role === 'admin'"
    }
  }
}
